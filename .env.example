APP_PORT=3000
# Runtime tuning. Defaults are used when omitted; set only when deployment needs different behavior.
APP_DB_POOL_MAX=5
APP_DB_CONNECTION_TIMEOUT_MS=5000
APP_DB_STATEMENT_TIMEOUT_MS=30000
APP_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
APP_DB_APPLICATION_NAME=qbo-invoice-sync
APP_HTTP_DEFAULT_CONNECTIONS=4
APP_HTTP_HEADERS_TIMEOUT_MS=10000
APP_HTTP_BODY_TIMEOUT_MS=10000
APP_HTTP_KEEP_ALIVE_TIMEOUT_MS=30000
APP_HTTP_KEEP_ALIVE_MAX_TIMEOUT_MS=60000
APP_SYNC_POLL_INTERVAL_MS=2000
APP_SYNC_JOB_LEASE_MS=300000
APP_SYNC_ENTITY_LEASE_MS=300000
APP_SYNC_ENTITY_LEASE_RETRY_DELAY_MS=1000
APP_SYNC_DEPENDENCY_RETRY_DELAY_MS=60000
APP_SYNC_MAX_RETRIES=10
APP_SYNC_RETRY_BASE_DELAY_MS=1000
APP_SYNC_RETRY_MAX_DELAY_MS=3600000
APP_QBO_ACCOUNTING_CONNECTIONS=4
APP_QBO_OAUTH_CONNECTIONS=2
APP_QBO_ACCESS_TOKEN_SAFETY_WINDOW_MS=120000
APP_QBO_REFRESH_LEASE_DURATION_MS=30000
APP_QBO_REFRESH_LEASE_RETRY_DELAY_MS=250
APP_QBO_REFRESH_LEASE_MAX_ATTEMPTS=8
APP_QBO_OAUTH_STATE_TTL_MS=600000
APP_QBO_OAUTH_START_RATE_LIMIT=5
APP_QBO_OAUTH_START_RATE_LIMIT_WINDOW_MS=60000
# Secret: this URL normally embeds PostgreSQL credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qbo_sync
# QBO integration configuration. These are non-secret provider and deployment settings.
QBO_AUTHORIZATION_ENDPOINT=https://appcenter.intuit.com/connect/oauth2
QBO_ACCOUNTING_API_ORIGIN=https://sandbox-quickbooks.api.intuit.com
QBO_OAUTH_ORIGIN=https://oauth.platform.intuit.com
QBO_TOKEN_PATH=/oauth2/v1/tokens/bearer
QBO_ACCOUNTING_SCOPE=com.intuit.quickbooks.accounting
QBO_REDIRECT_URI=http://localhost:3000/v1/qbo/oauth/callback
QBO_CLIENT_ID=
# Additional secrets. Generate independent application keys with `openssl rand -base64 32`; never reuse them.
INTERNAL_API_KEY=
QBO_SETUP_API_KEY=
# Generate in Intuit Developer > Keys & credentials. Never commit real values.
QBO_CLIENT_SECRET=
QBO_WEBHOOK_VERIFIER_TOKEN=
# Base64 32-byte key; keep in a Kubernetes Secret or KMS-backed secret manager.
QBO_TOKEN_ENCRYPTION_KEY=
# Local stress-test inputs. The script creates real internal and sandbox-QBO invoices.
STRESS_CREATE_CONFIRM=
STRESS_CREATE_COUNT=10
STRESS_CREATE_CONCURRENCY=5
STRESS_QBO_CUSTOMER_REF=
STRESS_QBO_ITEM_REF=
STRESS_UPDATE_CONFIRM=
STRESS_UPDATE_CONCURRENCY=5
STRESS_UPDATE_AMOUNT=2.00
STRESS_INTERNAL_INVOICE_IDS=
